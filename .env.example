# Copy to .env and fill in. Never commit .env.

SECRET_KEY=generate-with-python-c-import-secrets-print-secrets-token_urlsafe-50
DEBUG=False
ALLOWED_HOSTS=guides.ioref.org,localhost

# --- ioref-inventory -------------------------------------------------------
# The only channel to the inventory application. Generate a READ-scoped key in
# the inventory admin under "API keys"; the plaintext is shown once. This site
# must never hold a write-scoped key -- nothing here writes stock.
INVENTORY_API_URL=https://inventory.ioref.org
INVENTORY_API_KEY=
INVENTORY_API_TIMEOUT=3.0
INVENTORY_CACHE_SECONDS=120
