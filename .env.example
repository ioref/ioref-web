# Copy to .env and fill in. Never commit .env.

SECRET_KEY=generate-with-python-c-import-secrets-print-secrets-token_urlsafe-50
DEBUG=False
ALLOWED_HOSTS=guides.ioref.org,localhost

# --- ioref-inventory -------------------------------------------------------
# The only channel to the inventory application. Generate a READ-scoped key in
# the inventory admin under "API keys"; the plaintext is shown once. This site
# must never hold a write-scoped key -- nothing here writes stock.
INVENTORY_API_URL=https://inventory.ioref.org
INVENTORY_API_KEY=
INVENTORY_API_TIMEOUT=3.0
INVENTORY_CACHE_SECONDS=120

# --- Editor sign-in --------------------------------------------------------
# The guides are public regardless of this; it governs who reaches /admin.
#
#   local  Wagtail's own login form. Development, and installs with no IdP.
#   shib   mod_shib terminates SAML upstream; see deploy/apache/web.conf.
#   oidc   Entra or any OIDC provider (needs mozilla-django-oidc installed).
#
# The header defaults match CMU's attribute release and ioref-inventory's
# settings; override them only if the service provider is configured otherwise,
# and add anything new to the `RequestHeader unset` block in the vhost.
AUTH_MODE=shib
# REMOTE_USER_HEADER=HTTP_EPPN
# REMOTE_USER_EMAIL_HEADER=HTTP_MAIL
# REMOTE_USER_NAME_HEADER=HTTP_DISPLAYNAME
# REMOTE_USER_SUBJECT_HEADER=HTTP_PERSISTENT_ID
# SSO_LOGIN_URL=/Shibboleth.sso/Login
# SSO_LOGOUT_URL=/Shibboleth.sso/Logout
